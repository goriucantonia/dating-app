# Copy to `.env` (git-ignored) and fill in. Every variable the server config reads
# is named here (S1-D3).

# --- AI providers (not needed until Step 2; leave empty until then) ---
GOOGLE_AI_API_KEY=
OPENROUTER_API_KEY=

# Optional. The `litellm` provider reaches any upstream (Anthropic, OpenAI,
# Bedrock, Vertex, Groq, Ollama, a local vLLM) by its model string, and normally
# resolves a key PER UPSTREAM from the environment — so set ANTHROPIC_API_KEY,
# OPENAI_API_KEY etc. directly and leave this empty. Set it only to force one
# key across every litellm route, which is the shape for a LiteLLM proxy.
LITELLM_API_KEY=

# --- Auth ---
# Any long random string; sessions die if it changes.
JWT_SECRET=change-me-to-a-long-random-string

# --- Database ---
# Compose builds DATABASE_URL for the api container from the POSTGRES_* values
# below (host `db` on the compose-internal network). Set DATABASE_URL directly
# only when running the server outside Compose.
POSTGRES_USER=dating
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dating_app
DATABASE_URL=postgresql+asyncpg://dating:change-me@localhost:5432/dating_app
